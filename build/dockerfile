# Builds the Vue frontend into FellScout/public/, so the image doesn't depend
# on a frontend build already sitting in the working tree.
FROM node:22-slim AS frontend
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend ./
# vite.config.js writes to ../FellScout/public
RUN mkdir -p ../FellScout/public && npm run build

# The Perl runtime without the app. compose.dev.yaml stops here
# (`target: runtime`) and bind-mounts the repo instead, so it doesn't pay for
# a frontend build it never uses.
FROM debian:trixie-slim AS runtime
RUN apt-get update && \
    apt-get -y install vim \
      libdancer2-perl \
      libdancer2-plugin-database-perl \
      libtext-csv-perl \
      libgeo-coordinates-osgb-perl \
      libdbd-mariadb-perl \
      libdbd-mysql-perl \
      libjson-perl \
      starman \
      curl
EXPOSE 5000/tcp
ENTRYPOINT ["/usr/bin/plackup", "bin/app.psgi"]

FROM runtime
WORKDIR /app
COPY FellScout /app
COPY --from=frontend /src/FellScout/public/ /app/public/
# Explicit, because Starman sets PLACK_ENV=deployment, which Dancer2 would
# otherwise take as its environment - there's no deployment.yml, so it would
# fall back to config.yml's File logger and its non-existent log_dir.
ENV DANCER_ENVIRONMENT=production
# Starman rather than plackup's single-process server, so a FellTrack sync
# (which runs inside the /cron request) doesn't stall everyone else.
# 0.0.0.0 because Net::Server otherwise prefers [::], which fails on
# Docker's default IPv4-only network; deploy/k8s overrides this for IPv6.
ENTRYPOINT ["starman"]
CMD ["--listen", "0.0.0.0:5000", "bin/app.psgi"]
